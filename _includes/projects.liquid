<div class="col mb-4">
  <div class="card project-card h-100 hoverable">

    {% if project.img %}
    <div class="project-thumb-wrap">
      {%
        include figure.liquid
        loading="eager"
        path=project.img
        sizes="(min-width: 992px) 380px, (min-width: 768px) 50vw, 100vw"
        alt="project thumbnail"
        class="card-img-top project-thumb"
      %}
    </div>
    {% endif %}

    <div class="card-body d-flex flex-column">
      <h2 class="card-title project-title">
        <a class="stretched-link"
           href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
          {{ project.title }}
        </a>
      </h2>

      {% if project.subtitle %}
        <p class="project-subtitle">{{ project.subtitle }}</p>
      {% endif %}

      <p class="card-text project-desc flex-grow-1">
        {{ project.description }}
      </p>

      {% if project.github %}
        <div class="project-footer mt-3">
          <a class="footer-link" href="{{ project.github }}" target="_blank" rel="noopener">
            <i class="fa-brands fa-github"></i>
            <span>View on GitHub</span>
          </a>
        </div>
      {% endif %}
    </div>

  </div>
</div>
