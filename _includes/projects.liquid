<div class="col">
  <div class="card h-100 project-card shadow-sm border-0">

    {% if project.img %}
      <a class="project-card-link"
         href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
        <img
          src="{{ project.img | relative_url }}"
          alt="project thumbnail"
          class="card-img-top project-thumb"
          loading="eager">
      </a>
    {% endif %}

    <div class="card-body d-flex flex-column">
      <h2 class="card-title project-title mb-2">
        <a class="stretched-link project-title-link"
           href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
          {{ project.title }}
        </a>
      </h2>

      {% if project.subtitle %}
        <div class="project-subtitle mb-2">{{ project.subtitle }}</div>
      {% endif %}

      <p class="card-text project-desc flex-grow-1">
        {{ project.description }}
      </p>

      <div class="project-footer mt-3">
        {% if project.github %}
          <a class="footer-link"
             href="{{ project.github }}"
             target="_blank" rel="noopener">
            <i class="fa-brands fa-github"></i>
            <span>View on GitHub</span>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>
