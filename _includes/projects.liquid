<div class="col">
  <a class="project-card-link"
     href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">

    <div class="project-card h-100">

      {% if project.img %}
      <div class="project-thumb-wrap">
        {% include figure.liquid
          loading="eager"
          path=project.img
          alt="project thumbnail"
          class="project-thumb"
        %}

        {% if project.year or project.status %}
        <div class="project-meta">
          {% if project.year %}
            <span class="pill">{{ project.year }}</span>
          {% endif %}
          {% if project.status %}
            <span class="pill pill-status">{{ project.status }}</span>
          {% endif %}
        </div>
        {% endif %}
      </div>
      {% endif %}

      <div class="card-body d-flex flex-column">

        <h3 class="project-title">
          {{ project.title }}
        </h3>

        {% if project.subtitle %}
          <div class="project-subtitle">{{ project.subtitle }}</div>
        {% endif %}

        <p class="project-desc flex-grow-1">
          {{ project.description }}
        </p>

        {% if project.tags %}
        <div class="tag-row">
          {% for tag in project.tags %}
            <span class="tag">{{ tag }}</span>
          {% endfor %}
        </div>
        {% endif %}

      </div>

      {% if project.links.github %}
      <div class="project-footer">
        <a class="footer-link"
           href="{{ project.links.github }}"
           target="_blank" rel="noopener">
          <i class="fa-brands fa-github"></i> Code
        </a>
      </div>
      {% endif %}

    </div>
  </a>
</div>
