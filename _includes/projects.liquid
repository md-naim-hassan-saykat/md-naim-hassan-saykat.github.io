<div class="col">
  <div class="card h-100 hoverable project-card">

    {% if project.img %}
      {%
        include figure.liquid
        loading="eager"
        path=project.img
        sizes="(min-width: 992px) 380px, (min-width: 768px) 50vw, 100vw"
        alt="project thumbnail"
        class="card-img-top project-thumb"
      %}
    {% endif %}

    <div class="card-body d-flex flex-column project-body">

      <h2 class="card-title project-title">
        <a class="stretched-link project-title-link"
           href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
          {{ project.title }}
        </a>
      </h2>

      {% if project.subtitle %}
        <p class="project-subtitle mb-2">{{ project.subtitle }}</p>
      {% endif %}

      <p class="card-text project-desc flex-grow-1">
        {{ project.description }}
      </p>

      {% if project.github %}
        <div class="project-footer mt-3">
          <a class="project-gh-link"
             href="{{ project.github }}" target="_blank" rel="noopener">
            <i class="fa-brands fa-github"></i>
            <span>View on GitHub</span>
          </a>

          {% if project.github_stars %}
            <span class="project-stars" data-toggle="tooltip" title="GitHub Stars">
              <i class="fa-solid fa-star"></i>
              <span id="{{ project.github_stars }}-stars"></span>
            </span>
          {% endif %}
        </div>
      {% endif %}

    </div>
  </div>
</div>
