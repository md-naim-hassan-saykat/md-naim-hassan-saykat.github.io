<div class="col">
  <div class="card project-card h-100 hoverable">

    {% if project.img %}
      <div class="project-thumb-wrap">
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          alt=project.title
          class="project-thumb"
        %}

        <div class="project-meta">
          {% if project.year %}
            <span class="pill">{{ project.year }}</span>
          {% endif %}
          {% if project.status %}
            <span class="pill pill-status">{{ project.status }}</span>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <div class="card-body d-flex flex-column">
      <h2 class="card-title project-title">
        <a class="stretched-link"
           href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
          {{ project.title }}
        </a>
      </h2>

      {% if project.subtitle %}
        <p class="project-subtitle">{{ project.subtitle }}</p>
      {% endif %}

      <p class="card-text project-desc flex-grow-1">
        {{ project.description }}
      </p>

      {% if project.tags %}
        <div class="tag-row">
          {% for t in project.tags %}
            <span class="tag">{{ t }}</span>
          {% endfor %}
        </div>
      {% endif %}

      <div class="project-footer mt-3">
        {% if project.github %}
  <div class="project-footer mt-3">
    <a class="footer-link"
       href="{{ project.github }}"
       target="_blank"
       rel="noopener">
      <i class="fa-brands fa-github"></i>
      <span>View on GitHub</span>
    </a>
  </div>
{% endif %}

        {% if project.paper %}
          <a class="footer-link" href="{{ project.paper }}" target="_blank" rel="noopener">
            <i class="fa-regular fa-file-lines"></i> Paper
          </a>
        {% endif %}

        {% if project.doi %}
          <a class="footer-link" href="{{ project.doi }}" target="_blank" rel="noopener">
            <i class="fa-solid fa-link"></i> DOI
          </a>
        {% endif %}
      </div>
    </div>

  </div>
</div>
